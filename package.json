{
  "name": "chatbot-ia",
  "version": "0.1.0",
  "description": "Chatbot con IA (GPT/Claude) parametrizable por negocio - niveles Basic / Standard / Premium",
  "main": "dist/server.js",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && mkdir -p dist/config && cp src/config/*.json dist/config/",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "rag:index": "tsx src/rag/cli.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pdf-parse": "1.1.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/pdf-parse": "^1.1.5",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=18"
  }
}
