# === IA ===
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Proveedor activo para el chat de este cliente/nivel: openai | anthropic
AI_PROVIDER=openai
# Modelos por defecto (ajustar según disponibilidad de cada proveedor)
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-5
# Usado por RAG para generar embeddings (siempre OpenAI, ver src/rag/embeddingsClient.ts).
# Si AI_PROVIDER=anthropic, igual necesitas completar OPENAI_API_KEY arriba para que RAG funcione.
EMBEDDINGS_MODEL=text-embedding-3-small

# === Servidor ===
PORT=3000
# Orígenes permitidos para el widget (coma-separado). "*" solo para pruebas.
CORS_ORIGIN=*

# === WhatsApp (Standard) ===
# Vacío = canal desactivado. "twilio" (implementado) | "meta" (no implementado, ver whatsappAdapter.ts)
WHATSAPP_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número de WhatsApp habilitado en Twilio, formato "whatsapp:+14155238886"
TWILIO_WHATSAPP_NUMBER=

# === RAG (Standard) ===
# Ruta del índice vectorial (JSON) generado por `npm run rag:index -- archivo.pdf`
RAG_STORE_PATH=./data/rag-index.json

# === Log de conversaciones (Standard) ===
SQLITE_PATH=./data/conversations.sqlite
# Token requerido en el header "x-admin-token" para GET /admin/conversations/export.
# Vacío = endpoint sin protección (solo recomendable en local).
ADMIN_TOKEN=

# === Base de datos real (Premium) ===
DATABASE_URL=
