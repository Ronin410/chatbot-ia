# === IA ===
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Proveedor activo para este cliente/nivel: openai | anthropic
AI_PROVIDER=openai
# Modelos por defecto (ajustar según disponibilidad de cada proveedor)
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-5

# === Servidor ===
PORT=3000
# Orígenes permitidos para el widget (coma-separado). "*" solo para pruebas.
CORS_ORIGIN=*

# === WhatsApp (Standard+) ===
WHATSAPP_PROVIDER=twilio
WHATSAPP_TOKEN=

# === Base de datos (Standard+/Premium) ===
DATABASE_URL=
